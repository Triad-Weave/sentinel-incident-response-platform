# Sentinel local development configuration (NEVER commit real secrets — PB-08)
# Copy to .env for local docker-compose runs.

# Postgres (4 databases on platform Postgres: orders, payments, sentinel, chaos)
POSTGRES_SUPERUSER_PASSWORD=dev-postgres-only
ORDERS_DB_URL=postgresql+asyncpg://orders_app:orders_dev_pw@postgres:5432/orders
PAYMENTS_DB_URL=postgresql+asyncpg://payments_app:payments_dev_pw@postgres:5432/payments
SENTINEL_API_DB_URL=postgresql+asyncpg://sentinel_api:sentinel_api_dev_pw@postgres:5432/sentinel
SENTINEL_WORKER_DB_URL=postgresql+asyncpg://sentinel_worker:sentinel_worker_dev_pw@postgres:5432/sentinel
SENTINEL_ACTUATOR_DB_URL=postgresql+asyncpg://sentinel_actuator:sentinel_actuator_dev_pw@postgres:5432/sentinel
CHAOS_DB_URL=postgresql+asyncpg://chaos_rw:chaos_dev_pw@postgres:5432/chaos

# Platform Queue (RabbitMQ, PB-12)
RABBITMQ_URL=amqp://sentinel:sentinel_queue_dev_pw@rabbitmq:5672/

# Service & Operator Tokens (dev placeholders; SealedSecrets in K8s)
CHAOS_OPERATOR_TOKEN=dev-chaos-operator-token
CHAOS_ORDERS_READ_TOKEN=dev-chaos-orders-token
CHAOS_PAYMENTS_READ_TOKEN=dev-chaos-payments-token
ALERTMANAGER_WEBHOOK_TOKEN=dev-alertmanager-webhook-token
SENTINEL_SESSION_SECRET=dev-session-secret-change-me
SENTINEL_MCP_TOKEN=dev-mcp-token
DEPLOY_HISTORY_READ_TOKEN=dev-deploy-history-token
EVAL_STORE_TOKEN=dev-eval-store-token

# LLM Gateway (PB-14)
# In local dev, dev-shims/llm_gateway runs in deterministic mock mode if UPSTREAM_LLM_API_KEY is unset,
# or proxies to any OpenAI-compatible provider (OpenAI / Gemini OpenAI endpoint / LiteLLM) when set.
LLM_GATEWAY_URL=http://llm-gateway:8090/v1
LLM_GATEWAY_API_KEY=dev-sentinel-gateway-key
SENTINEL_AGENT_MODEL=gpt-4o-mini
SENTINEL_JUDGE_MODEL=gpt-4o
SENTINEL_DAILY_BUDGET_USD=10.0
UPSTREAM_LLM_BASE_URL=
UPSTREAM_LLM_API_KEY=

# Agent Hard Limits (FR-AG-06)
AGENT_MAX_TOOL_CALLS=14
AGENT_MAX_WALL_SECONDS=150
AGENT_MAX_INPUT_TOKENS=90000
AGENT_MAX_OUTPUT_TOKENS=6000
AGENT_MAX_COST_USD=0.35

# Feature flags (Should/Could)
ENABLE_RESTART_ACTION=true
ENABLE_POSTMORTEM=true
ENABLE_FOLLOWUP_QUESTIONS=true
OTEL_TRACES_ENABLED=false

# Rollback executor mode: crd (K8s PB-07) | http_shim (local docker-compose) | git_pr (ADR-003 fallback)
ROLLBACK_MODE=http_shim
PB07_CONTROLLER_URL=http://rollback-controller:8095

# Canary secrets for Payments NFR-05 audit verification (fake values only!)
CANARY_PASSWORD=canary-pw-sentinel-9f8e7d6c
CANARY_BEARER_TOKEN=canary-tok-sentinel-a1b2c3d4e5f6

# Console initial local accounts (dev only)
SEED_RESPONDER_EMAIL=responder@sentinel.local
SEED_RESPONDER_PASSWORD=responder-dev-pass
SEED_VIEWER_EMAIL=viewer@sentinel.local
SEED_VIEWER_PASSWORD=viewer-dev-pass
