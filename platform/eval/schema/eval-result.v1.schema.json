{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.cohort.dev/schemas/eval-result.v1.schema.json",
  "title": "EvalResultV1",
  "description": "Shared evaluation report format (PB-15) for Sentinel, Lumen, and Folio.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "project",
    "suite",
    "created_at",
    "git_sha",
    "prompt_version",
    "model",
    "repeats",
    "passed",
    "metrics",
    "items"
  ],
  "properties": {
    "schema_version": { "const": "eval-result/v1" },
    "run_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "project": { "enum": ["sentinel", "lumen", "folio"] },
    "suite": { "type": "string", "minLength": 1, "maxLength": 64 },
    "created_at": { "type": "string", "format": "date-time" },
    "git_sha": { "type": "string", "minLength": 4, "maxLength": 64 },
    "prompt_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "model": { "type": "string", "minLength": 1, "maxLength": 128 },
    "judge_model": { "type": ["string", "null"], "maxLength": 128 },
    "repeats": { "type": "integer", "minimum": 1, "maximum": 10 },
    "passed": { "type": "boolean" },
    "failure_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": ["number", "integer", "null"] }
    },
    "metric_ranges": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["mean", "min", "max"],
        "additionalProperties": false,
        "properties": {
          "mean": { "type": "number" },
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "passed", "metrics"],
        "additionalProperties": true,
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "repeat": { "type": "integer", "minimum": 1 },
          "passed": { "type": "boolean" },
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": ["number", "integer", "boolean", "string", "null"] }
          },
          "details": { "type": "object" }
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
